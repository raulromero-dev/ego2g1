# --- data: everything heavy stays out of git (see docs/data-schema.md) ---
data/**
!data/**/.gitkeep
!data/**/README.md

# vendored upstream repos (clone via scripts/bootstrap_third_party.sh)
third_party/*
!third_party/.gitkeep

# body models / robot assets with restrictive licenses — never commit
assets/smplx/**
assets/smpl/**
*.npz
*.pkl
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx

# media. The rules below exist for raw captures and renders, which are large and
# reproducible. The showcase site is neither: its videos ARE the deliverable, so they
# are exempted rather than the rule being loosened everywhere.
*.mp4
*.mov
*.MOV
!site/public/video/*.mp4
*.r3d
*.usdz
*.hdf5
*.h5
*.zarr/

# training junk
runs/
outputs/
wandb/
logs/
.rerun/
*.rrd

# python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# macos / editors
.DS_Store
.vscode/
.idea/

# raw egocentric captures (large; keep out of git)
egocentric-data/

# downloaded general corpus (147 min of LAFAN1 retargeted to G1)
data/35_reference/general/

# the original of the site's dad-and-me.jpg; the cropped one in site/ is the published copy
papa_y_yo.jpeg
